{
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www.divasafresh.in"
        }
      ],
      "destination": "https://divasafresh.in/:path*",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "divasafresh.in"
        },
        {
          "type": "header",
          "key": "x-forwarded-proto",
          "value": "http"
        }
      ],
      "destination": "https://divasafresh.in/:path*",
      "permanent": true
    }
  ],
 "rewrites": [
  {
    "source": "/((?!.*\\.).*)",
    "destination": "/index.html"
  }
]
}
